{
  "name": "unmarky-monorepo",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm --workspace web run dev",
    "dev:api": "npm --workspace api run dev",
    "build:web": "npm --workspace web run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm --workspace api run db:generate",
    "db:migrate": "npm --workspace api run db:migrate"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.17",
    "@astryxdesign/theme-neutral": "^0.7.17",
    "@react-three/fiber": "^9.8.2",
    "@shadergradient/react": "^2.4.20",
    "@stylexjs/stylex": "^0.19.2",
    "@supabase-js/source": "supabase/supabase-js",
    "camera-controls": "^3.1.2",
    "react-doctor": "^0.9.12",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.17",
    "@types/three": "^0.187.0"
  },
  "packageManager": "npm@11.11.1"
}
