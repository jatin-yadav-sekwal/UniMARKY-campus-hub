# --- apps/web ---
# Same-origin path proxied to the API by the Vercel rewrite in vercel.json.
# For local development against a local API use http://localhost:3000/api
VITE_API_URL=/api

VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Used for OAuth redirects back to the web app.
VITE_WEB_URL=http://localhost:5173
