{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "@lynx-js/types"
    ],
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./intrinsic.d.ts"
  ]
}