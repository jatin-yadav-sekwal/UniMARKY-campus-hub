{
  "compilerOptions": {
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2015",
    "lib": [
      "es2015",
      "dom",
      "esnext"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "@lynx-js/types"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}