{
  "compilerOptions": {
    // Environment setup & latest features
    // `dom` supplies the web globals Node exposes at runtime (fetch, crypto,
    // CryptoKey, console) that this @types/node build no longer declares.
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    // The codebase uses the drizzle `.returning()[0]` pattern everywhere,
    // guarded by a prior length check. Keep this off so `npm run typecheck`
    // reports real problems instead of dozens of false positives.
    "noUncheckedIndexedAccess": false,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
